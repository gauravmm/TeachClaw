{
  "markdownlint.config": {
    "MD040": false
  },
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    ".venv/": true,
    "bridge/node_modules": true,
    ".ruff_cache/": true,
    "**/__pycache__": true,
    ".pytest_cache": true,
  },
  "python.testing.pytestArgs": ["tests"],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true
}
